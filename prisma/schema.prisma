// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  kioskToken    String?   @unique @map("kiosk_token")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  dinners       Dinner[]
  groceries     Grocery[]
  budgetIncomes BudgetIncome[]
  budgetExpenses BudgetExpense[]
  preferences   UserPreferences?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  colors    Json?    // Custom color scheme
  background String? // Custom background
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model Dinner {
  id          String   @id @default(cuid())
  date        DateTime
  mealName    String   @map("meal_name")
  description String?
  isComplete  Boolean  @default(false) @map("is_complete")
  orderIndex  Int      @default(0) @map("order_index")
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Support for multi-day meals
  linkedDinnerId String? @map("linked_dinner_id")
  linkedDinner   Dinner?  @relation("LinkedDinners", fields: [linkedDinnerId], references: [id])
  linkedDinners  Dinner[] @relation("LinkedDinners")

  @@index([userId, date])
  @@map("dinners")
}

model Grocery {
  id         String   @id @default(cuid())
  itemName   String   @map("item_name")
  category   String
  quantity   String?
  isComplete Boolean  @default(false) @map("is_complete")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, category])
  @@map("groceries")
}

model BudgetIncome {
  id             String   @id @default(cuid())
  source         String
  expectedPay    Decimal  @map("expected_pay") @db.Decimal(10, 2)
  frequencyType  String   @map("frequency_type") // 'monthly' | 'weekly'
  frequencyValue Int      @map("frequency_value") // x in "x/month" or "every x weeks"
  frequencyDays  Json     @map("frequency_days") // Array for monthly days or single day for weekly
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("budget_income")
}

model BudgetExpense {
  id         String   @id @default(cuid())
  category   String   // 'bills' | 'cards' | 'ad_hoc'
  source     String
  amount     Decimal  @db.Decimal(10, 2)
  dueDate    DateTime @map("due_date")
  paidAmount Decimal  @default(0) @map("paid_amount") @db.Decimal(10, 2)
  paidDate   DateTime? @map("paid_date")
  balance    Decimal  @default(0) @db.Decimal(10, 2)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, category])
  @@index([userId, dueDate])
  @@map("budget_expenses")
}
