// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  super_user
  user
  read_only
}

enum UserStatus {
  active
  inactive
  pending_approval
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?   @map("email_verified")
  name          String?
  firstName     String?     @map("first_name")
  lastName      String?     @map("last_name")
  image         String?
  kioskToken    String?     @unique @map("kiosk_token")
  role          UserRole?
  status        UserStatus?  @default(active)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  accounts       Account[]
  sessions       Session[]
  dinners         Dinner[]
  dinnerRotations DinnerRotation[]
  groceries       Grocery[]
  budgetIncomes   BudgetIncome[]
  budgetExpenses  BudgetExpense[]
  projectTodos    ProjectTodo[]
  preferences     UserPreferences?
  auditLogsDone   AdminAuditLog[] @relation("AdminAuditLogAdmin")

  @@map("users")
}

model AppConfig {
  id                    String   @id @default(cuid())
  allowAccountCreation  Boolean  @default(false) @map("allow_account_creation")
  auditUserCrud        Boolean  @default(false) @map("audit_user_crud")
  householdUserId      String?  @map("household_user_id") // When set, all widget data is shared under this user
  weatherLat           Float?   @map("weather_lat")
  weatherLon           Float?   @map("weather_lon")
  weatherLocationName  String?  @map("weather_location_name")
  calendarConfigs      Json?    @map("calendar_configs") // [{ id: string, color?: string }]
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String   @map("admin_user_id")
  action      String
  targetUserId String? @map("target_user_id")
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser User @relation("AdminAuditLogAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([createdAt])
  @@map("admin_audit_log")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserPreferences {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  colors         Json?    // Custom color scheme
  background    String?  // Custom background
  projectsConfig Json?   @map("projects_config") // { columns: [{ id, label, color }] }
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

enum ProjectTodoStatus {
  NOT_READY
  STARTING
  IN_PROGRESS
  COMPLETE
}

model ProjectTodo {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  priority        Int               // 1, 2, or 3
  initialPriority Int?              @map("initial_priority") // Set when created; used for completion analytics
  status          ProjectTodoStatus @default(NOT_READY)
  completedAt     DateTime?         @map("completed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("project_todos")
}

model Dinner {
  id          String   @id @default(cuid())
  date        DateTime
  mealName    String   @map("meal_name")
  description String?
  url         String?  // Optional link to online recipe; edit-only, not shown in plan/rotation/collapsed
  ingredients String?  // Optional; for future grocery list aggregation; edit-only
  isComplete  Boolean  @default(false) @map("is_complete")
  orderIndex  Int      @default(0) @map("order_index")
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Support for multi-day meals
  linkedDinnerId String? @map("linked_dinner_id")
  linkedDinner   Dinner?  @relation("LinkedDinners", fields: [linkedDinnerId], references: [id])
  linkedDinners  Dinner[] @relation("LinkedDinners")

  @@index([userId, date])
  @@map("dinners")
}

model DinnerRotation {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealName    String   @map("meal_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("dinner_rotations")
}

model Grocery {
  id         String   @id @default(cuid())
  itemName   String   @map("item_name")
  category   String
  quantity   String?
  isComplete Boolean  @default(false) @map("is_complete")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, category])
  @@map("groceries")
}

model BudgetIncome {
  id             String   @id @default(cuid())
  source         String
  expectedPay    Decimal  @map("expected_pay") @db.Decimal(10, 2)
  frequencyType  String   @map("frequency_type") // 'monthly' | 'weekly'
  frequencyValue Int      @map("frequency_value") // x in "x/month" or "every x weeks"
  frequencyDays  Json     @map("frequency_days") // Array for monthly days or single day for weekly
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("budget_income")
}

model BudgetExpense {
  id         String   @id @default(cuid())
  category   String   // 'bills' | 'cards' | 'ad_hoc'
  source     String
  amount     Decimal  @db.Decimal(10, 2)
  dueDate    DateTime @map("due_date")
  paidAmount Decimal  @default(0) @map("paid_amount") @db.Decimal(10, 2)
  paidDate   DateTime? @map("paid_date")
  balance    Decimal  @default(0) @db.Decimal(10, 2)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, category])
  @@index([userId, dueDate])
  @@map("budget_expenses")
}
