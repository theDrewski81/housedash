# Database Configuration
# PostgreSQL connection string for Prisma
# Format: postgresql://user:password@host:port/database
# For local development with Docker: postgresql://postgres:postgres@localhost:5432/housedash
DATABASE_URL=postgresql://user:password@localhost:5432/housedash

# NextAuth Configuration
# Base URL of your application (required for OAuth callbacks)
# For local development: http://localhost:3000
# For production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# Secret key for encrypting JWT tokens and session cookies
# Generate a random string: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# API Keys
# OpenWeatherMap API Key
# Get from: https://openweathermap.org/api
# Free tier available with registration
OPENWEATHER_API_KEY=your-openweather-api-key

# Google Calendar API Key
# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Enable Google Calendar API for your project
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key

# Kiosk Mode Authentication
# Secret token for kiosk mode (tablet access)
# Generate a secure random string: openssl rand -hex 32
KIOSK_TOKEN=your-kiosk-token-here